<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnforceRuntimeBoundary>true</EnforceRuntimeBoundary>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>repolore</ToolCommandName>
    <PackageId>RepoLore.Cli</PackageId>
    <RollForward>LatestPatch</RollForward>
    <Authors>R-Elias</Authors>
    <Description>RepoLore: local, offline operational memory for developers and coding agents, stored as Markdown. Installs the repolore command.</Description>
    <PackageTags>repolore;knowledge;markdown;cli;agents</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/R-Elias/repolore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/R-Elias/repolore.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RepoLore.Core/RepoLore.Core.csproj" />
    <ProjectReference Include="../RepoLore.Infrastructure/RepoLore.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="GenerateCliVersion" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)CliVersion.g.cs"
      Lines="namespace RepoLore.Cli { internal static class CliVersion { internal const string Value = &quot;$(Version)&quot;%3B } }"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)CliVersion.g.cs" /></ItemGroup>
  </Target>
</Project>
