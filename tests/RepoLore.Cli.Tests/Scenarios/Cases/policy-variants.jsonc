// Source discovery and history coverage are independent policies: the ignore file's exclusion and re-inclusion show
// in --explain, and a history.exclude rule keeps a generated note out of every checkpoint. The same rules under the
// preview's file name (_repoloreignore) are reported for renaming and not read.
{
  "name": "policy-variants",
  "tags": ["configuration"],
  "steps": [
    { "checkout": "s40-policy-variants-renamed" },
    { "run": "health-check --explain generated/keep/", "expect": { "exit": 0, "stdout": "source discovery: included (user rule '!generated/keep/')" } },
    { "run": "health-check --explain generated/tmp/", "expect": { "exit": 0, "stdout": "source discovery: excluded (user rule 'generated/*')" } },
    { "run": "health-check --explain vendor/acme-sdk/", "expect": { "exit": 0, "stdout": "source discovery: excluded (user rule 'vendor/')" } },
    { "run": "checkpoint", "expect": { "exit": 0, "stdout": "checkpoint 0000000000000001: 20 files" } },
    { "run": "history", "expect": { "exit": 0, "stdout": ".repoloreignore", "stdout-not": "generated-diagram.md" } },
    { "checkout": "s16-policy-variants" },
    { "run": "health-check", "expect": { "exit": 3,
      "stdout": "policy-error _repoloreignore: the ignore file is now named .repoloreignore; rename this file, whose rules are not read until then" } },
    { "run": "health-check --explain generated/keep/", "expect": { "exit": 3, "stdout-not": "user rule" } }
  ]
}
