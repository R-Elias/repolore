// Unknown commands and options, and running outside a knowledge base, are usage errors (exit 2).
{
  "name": "usage-errors",
  "tags": ["cli"],
  "steps": [
    { "checkout": "s01-plain-monorepo" },
    { "run": "health-check --json", "expect": { "exit": 2, "json": { "error.id": "usage" } } },
    { "checkout": "s04-knowledge-adopted" },
    { "run": "frobnicate", "expect": { "exit": 2, "stderr": ["Usage: repolore <command> [options]", "unknown command: frobnicate"] } },
    { "run": "context --bogus --json", "expect": { "exit": 2, "json": { "error.id": "usage", "error.message": "unknown option: --bogus" } } }
  ]
}
